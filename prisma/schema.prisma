generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  INVESTMENT_RETURN
  REFERRAL_REWARD
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  referralCode String  @unique
  referredById String?

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  wallet Wallet?

  transactions Transaction[]
  investments  Investment[]
  deposits     Deposit[]
  withdrawals  Withdrawal[]

  referralsGiven    Referral[] @relation("Referrer")
  referralsReceived Referral[] @relation("ReferredUser")

  notifications Notification[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referredBy User?  @relation("UserReferrals", fields: [referredById], references: [id])
  referrals  User[] @relation("UserReferrals")

  @@index([referredById])
  @@index([status])
  @@index([createdAt])
}

model Wallet {
  id     String @id @default(cuid())
  userId String @unique

  balance          Decimal @default(0) @db.Decimal(18, 2)
  availableBalance Decimal @default(0) @db.Decimal(18, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id       String @id @default(cuid())
  userId   String
  walletId String

  type   TransactionType
  status TransactionStatus @default(PENDING)

  amount      Decimal @db.Decimal(18, 2)
  description String?
  reference   String? @unique

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model CompanyBank {
  id            String @id @default(cuid())
  companyName   String
  bankName      String
  accountNumber String
  branchCode    String
  accountType   String

  supportEmail String?
  supportPhone String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model InvestmentPlan {
  id          String  @id @default(cuid())
  name        String
  description String?

  minimumAmount Decimal @db.Decimal(18, 2)
  durationDays  Int
  returnRate    Decimal @db.Decimal(10, 4)

  isActive Boolean @default(true)

  investments Investment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Investment {
  id     String @id @default(cuid())
  userId String
  planId String

  amount Decimal @db.Decimal(18, 2)

  startDate DateTime
  endDate   DateTime

  earnedAmount Decimal @default(0) @db.Decimal(18, 2)

  isActive Boolean @default(true)

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan InvestmentPlan @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([isActive])
  @@index([endDate])
}

model Deposit {
  id     String @id @default(cuid())
  userId String

  amount Decimal @db.Decimal(18, 2)

  proofUrl  String?
  reference String?

  status TransactionStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Withdrawal {
  id     String @id @default(cuid())
  userId String

  amount        Decimal @db.Decimal(18, 2)
  bankName      String
  accountName   String
  accountNumber String
  branchCode    String

  status TransactionStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Referral {
  id             String @id @default(cuid())
  referrerId     String
  referredUserId String

  rewardAmount Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  referrer     User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredUserId])
  @@index([referrerId])
  @@index([referredUserId])
}

model Notification {
  id     String @id @default(cuid())
  userId String

  title   String
  message String
  isRead  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?

  action      String
  entity      String?
  entityId    String?
  description String?
  metadata    Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}
